import mlflow
from datasets import Dataset

# Log runs under your own user folder (the course hard-codes the instructor's)
user = spark.sql("SELECT current_user()").first()[0]
mlflow.set_experiment(f"/Users/{user}/image-claims-classifier")

# 56 rows is small, so convert via pandas
pdf = spark.table("smart_claims_dev.02_silver.training_images_resized").select("content", "label").toPandas()
dataset = Dataset.from_pandas(pdf).rename_column("content", "image")

splits = dataset.train_test_split(test_size=0.2, seed=42)
train_ds, val_ds = splits["train"], splits["test"]
print(train_ds)
print(val_ds)

# COMMAND ----------

import io
import torch
from PIL import Image
from transformers import AutoImageProcessor
from torchvision.transforms import Compose, Normalize, ToTensor, Lambda

# Pre-trained model to fine-tune: https://huggingface.co/microsoft/resnet-50
model_checkpoint = "microsoft/resnet-50"

# The processor holds the model's expected normalization values
model_def = AutoImageProcessor.from_pretrained(model_checkpoint)

transforms = Compose([
    Lambda(lambda b: Image.open(io.BytesIO(b)).convert("RGB")),  # bytes -> PIL image
    ToTensor(),                                                   # PIL image -> tensor
    Normalize(mean=model_def.image_mean, std=model_def.image_std)
])

def preprocess(batch):
    batch["image"] = [transforms(image) for image in batch["image"]]
    return batch

train_ds.set_transform(preprocess)
val_ds.set_transform(preprocess)

# COMMAND ----------

from transformers import AutoModelForImageClassification

label2id, id2label = dict(), dict()
for i, label in enumerate(set(dataset["label"])):
    label2id[label] = i
    id2label[i] = label

model = AutoModelForImageClassification.from_pretrained(
    model_checkpoint,
    label2id=label2id,
    id2label=id2label,
    num_labels=len(label2id),
    ignore_mismatched_sizes=True
)

# COMMAND ----------

from transformers import TrainingArguments

model_name = model_checkpoint.split("/")[-1]

args = TrainingArguments(
    f"/tmp/huggingface/{model_name}-finetuned",
    use_cpu=True,                  # newer name for the course's no_cuda=True
    remove_unused_columns=False,
    eval_strategy="epoch",         # newer name for evaluation_strategy
    save_strategy="epoch",
    num_train_epochs=20,
    load_best_model_at_end=True
)

# COMMAND ----------

import mlflow
import pandas as pd

# Wraps the HF pipeline so the logged model takes raw image bytes
# and returns only the top class and its score
class ModelWrapper(mlflow.pyfunc.PythonModel):
    def __init__(self, pipeline):
        self.pipeline = pipeline
        self.pipeline.model.eval()

    def predict(self, context, images):
        from PIL import Image
        with torch.set_grad_enabled(False):
            images = images['content'].apply(lambda b: Image.open(io.BytesIO(b))).to_list()
            predictions = self.pipeline.predict(images)
            return pd.DataFrame([max(r, key=lambda x: x['score']) for r in predictions])

# COMMAND ----------

from transformers import Trainer, pipeline
from mlflow.models import infer_signature

with mlflow.start_run(run_name="hugging_face_new") as run:
    try:
        mlflow.log_input(mlflow.data.from_huggingface(train_ds, "training"))
    except Exception as e:
        print("Skipping dataset logging:", e)   # optional lineage info; newer datasets versions can break it

    def collate_fn(examples):
        pixel_values = torch.stack([e["image"] for e in examples])
        labels = torch.tensor([label2id[e["label"]] for e in examples], dtype=torch.long)
        labels = torch.nn.functional.one_hot(labels, num_classes=len(label2id)).float()
        return {"pixel_values": pixel_values, "labels": labels}

    trainer = Trainer(model, args, train_dataset=train_ds, eval_dataset=val_ds,
                      processing_class=model_def,   # newer name for tokenizer=
                      data_collator=collate_fn)
    train_results = trainer.train()

    classifier = pipeline("image-classification", model=trainer.state.best_model_checkpoint,
                          image_processor=model_def)   # image_processor instead of tokenizer

    wrapped_model = ModelWrapper(classifier)
    test_df = spark.table("smart_claims_dev.02_silver.training_images_resized").select("content").toPandas()
    predictions = wrapped_model.predict(None, test_df)
    signature = infer_signature(test_df, predictions)

    logged = mlflow.pyfunc.log_model(
        name="model",                  # MLflow 3 name for artifact_path=
        python_model=wrapped_model,
        pip_requirements=mlflow.transformers.get_default_pip_requirements(model),
        signature=signature,
    )

print("model_uri:", logged.model_uri)

# COMMAND ----------

from mlflow import MlflowClient

mlflow.set_registry_uri("databricks-uc")
model_name = "smart_claims_dev.03_gold.claims_damage_level"

registered = mlflow.register_model(model_uri=logged.model_uri, name=model_name)

MlflowClient().set_registered_model_alias(
    name=model_name,
    alias="prod",
    version=registered.version,
)

print(f"Registered {model_name} v{registered.version} with alias 'prod'")

# COMMAND ----------

predict_damage_udf = mlflow.pyfunc.spark_udf(spark, model_uri=f"models:/{model_name}@prod")
columns = predict_damage_udf.metadata.get_input_schema().input_names()

(spark.table("smart_claims_dev.02_silver.training_images_resized")
    .withColumn("damage_prediction", predict_damage_udf(*columns))
    .write.mode("overwrite")
    .saveAsTable("smart_claims_dev.03_gold.damage_predictions"))

# COMMAND ----------

import pandas as pd

results = (spark.table("smart_claims_dev.03_gold.damage_predictions")
    .selectExpr("label", "damage_prediction.label AS prediction", "damage_prediction.score AS score")
    .toPandas())

print("Accuracy:", round((results["label"] == results["prediction"]).mean(), 3))
display(pd.crosstab(results["label"], results["prediction"]))

# COMMAND ----------

from pyspark.sql.functions import struct, col

# 1. Load the 15 claim photos into pandas and predict them directly
claim_pdf = spark.table("smart_claims_dev.02_silver.claim_images").toPandas()
model = mlflow.pyfunc.load_model(f"models:/{model_name}@prod")
preds = model.predict(claim_pdf[["content"]])

claim_pdf["pred_label"] = preds["label"].values
claim_pdf["pred_score"] = preds["score"].values

# 2. Back to Spark, packing the prediction into the same struct shape as before
claim_preds = (spark.createDataFrame(claim_pdf)
    .withColumn("damage_prediction",
                struct(col("pred_label").alias("label"), col("pred_score").alias("score")))
    .drop("pred_label", "pred_score"))

# 3. Now join the 15 scored images to the 13K claims and save
metadata = spark.table("smart_claims_dev.01_bronze.claim_images_meta")

(claim_preds.join(metadata, on="image_name")
    .write.mode("overwrite")
    .saveAsTable("smart_claims_dev.03_gold.claim_images_predicted"))

display(spark.table("smart_claims_dev.03_gold.claim_images_predicted")
    .select("image_name", "claim_no", "damage_prediction").limit(10))
